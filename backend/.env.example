# Required: OpenRouter API key
OPENROUTER_API_KEY=api_key

# LLM model routed through OpenRouter
OPENROUTER_MODEL=openrouter/openai/gpt-4o-mini

# Optional: contact email for Crossref/OpenAlex polite API pools
CROSSREF_MAILTO=satapathyrishi41@gmail.com
OPENALEX_MAILTO=satapathyrishi41@gmail.com

# Optional: Semantic Scholar API key for citation-aware discovery and ranking
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

# Optional Google OAuth sign-in (configure an OAuth 2.0 Web application in Google Cloud)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Generate a persistent signing key, for example: openssl rand -hex 32
SESSION_SECRET_KEY=replace_with_a_random_secret
# Set true when serving the backend over HTTPS
SESSION_COOKIE_SECURE=false
# Include both frontend dev origins if you use localhost and 127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
